# Neon connection string: Neon console → your project → Connect.
# Use the pooled connection (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
PORT=3000

# Better Auth. Secret: openssl rand -base64 32. URL = public origin of the app
# (must match what the browser uses, e.g. https://myapp.onrender.com in production).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional social sign-in. Leave blank and the button is shown greyed out.
# Google callback:    {BETTER_AUTH_URL}/api/auth/callback/google
# Facebook callback:  {BETTER_AUTH_URL}/api/auth/callback/facebook
# Instagram callback: {BETTER_AUTH_URL}/api/auth/callback/instagram
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
